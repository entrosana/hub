# entrosana-api env vars.  Copy to .env and fill.
# Never commit .env (gitignored).

# --- core ---
ENVIRONMENT=development                    # development|staging|production
LOG_LEVEL=INFO
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --- database ---
DATABASE_URL=postgresql+asyncpg://entrosana:devpass@localhost:5432/entrosana
DATABASE_POOL_SIZE=10

# --- redis / celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- DLM / Claude ---
ANTHROPIC_API_KEY=                         # for Co-Pilot tier
DLM_MODEL_VERSION=claude-sonnet-4-6        # pinned model id
DLM_PROMPT_VERSION=v0.1.0                  # pinned prompt bundle
DLM_TEMPERATURE=0
DLM_AUDIT_HMAC_KEY=replace-me              # signs every DLM interaction

# --- CashCtrl integration ---
CASHCTRL_API_BASE=https://<tenant>.cashctrl.com/api/v1
CASHCTRL_API_KEY=
CASHCTRL_WEBHOOK_SECRET=

# --- auth ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=entrosana-api
